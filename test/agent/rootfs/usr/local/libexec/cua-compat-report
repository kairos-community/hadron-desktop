#!/bin/sh

set -u

runtime_dir=/run/user/1000/hadron-cua-compat
stage_dir=/run/hadron-cua-compat-report
tar_path=/run/hadron-cua-compat.tar
artifact_device=/dev/disk/by-id/virtio-hadronagentartifacts

exec 3>/dev/ttyS0 || exit 1
exec >/dev/null 2>&1

emit() {
    printf 'CUACOMPAT: %s\n' "$1" >&3
}

wait_for_file() {
    path=$1
    remaining=$2
    while [ "$remaining" -gt 0 ]; do
        if [ -s "$path" ]; then
            return 0
        fi
        sleep 1
        remaining=$((remaining - 1))
    done
    return 1
}

umask 077
rm -rf "$stage_dir"
mkdir -p "$stage_dir"
report_log="$stage_dir/report.log"

record() {
    printf '%s\n' "$1" >> "$report_log"
}

emit BEGIN
waits_ok=1

if ! wait_for_file "$runtime_dir/collection.started" 60; then
    waits_ok=0
    record 'timed out waiting for collection.started'
fi
if ! wait_for_file "$runtime_dir/result.status" 240; then
    waits_ok=0
    record 'timed out waiting for result.status'
fi
if ! wait_for_file "$runtime_dir/collection.status" 30; then
    waits_ok=0
    record 'timed out waiting for collection.status'
fi

stage_ok=1
if [ -d "$runtime_dir" ]; then
    if ! cp -a "$runtime_dir"/. "$stage_dir"/; then
        stage_ok=0
        record 'failed to stage collector outputs'
    fi
else
    stage_ok=0
    record 'collector runtime directory is absent'
fi

if ! cp /run/user/1000/hadron-cua-gtk-state.json \
    "$stage_dir/gtk-state.json"; then
    stage_ok=0
    record 'failed to stage GTK state'
fi
if ! cp /etc/hadron-agent-test/chromium-commit \
    "$stage_dir/chromium.commit"; then
    stage_ok=0
    record 'failed to stage Chromium commit'
fi
if ! journalctl --no-pager -o short-precise _UID=1000 \
    > "$stage_dir/user-journal.log" 2>&1; then
    stage_ok=0
    record 'failed to collect UID 1000 journal'
fi

for required in result.json result.status cua-desktop.png environment.txt \
    cua-driver-doctor.json xprop-root.txt xrandr.txt collection.status; do
    if [ ! -s "$stage_dir/$required" ]; then
        stage_ok=0
        record "missing required artifact: $required"
    fi
done

result_status=FAIL
collection_status=FAIL
if [ -s "$runtime_dir/result.status" ]; then
    result_status="$(cat "$runtime_dir/result.status")"
fi
if [ -s "$runtime_dir/collection.status" ]; then
    collection_status="$(cat "$runtime_dir/collection.status")"
fi

overall_status=FAIL
if [ "$waits_ok" -eq 1 ] && [ "$stage_ok" -eq 1 ] && \
   [ "$result_status" = PASS ] && [ "$collection_status" = PASS ]; then
    overall_status=PASS
fi
printf '%s\n' "$overall_status" > "$stage_dir/report.status"

artifact_ok=1
rm -f "$tar_path"
if ! tar -C "$stage_dir" -cf "$tar_path" .; then
    artifact_ok=0
    record 'failed to create artifact tar'
fi
if [ "$artifact_ok" -eq 1 ]; then
    if [ ! -b "$artifact_device" ]; then
        artifact_ok=0
        record 'artifact block device is absent'
    elif ! dd if="$tar_path" of="$artifact_device" bs=1048576 \
        conv=notrunc,fsync status=none; then
        artifact_ok=0
        record 'failed to write artifact tar'
    fi
fi
rm -f "$tar_path"

if [ "$overall_status" = PASS ] && [ "$artifact_ok" -eq 1 ]; then
    emit PASS
else
    emit FAIL
fi
emit DONE
