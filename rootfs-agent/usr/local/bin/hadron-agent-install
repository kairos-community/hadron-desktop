#!/bin/sh
# hadron-agent-install: safe disk installer for the Cua agent appliance.
#
# SAFETY CONTRACT (this script is the ONLY thing on the appliance that writes a
# disk): it NEVER wipes a disk unless one of exactly two things is true:
#
#   1. INTERACTIVE (default): a human answered the prompts on tty1 and TYPED
#      the word `yes` (exactly) at the confirmation. Anything else loops or
#      aborts, and nothing is written.
#   2. NON-INTERACTIVE (--noninteractive, used only by the seed-gated
#      hadron-agent-autoinstall.service): the merged /oem seed FULLY authorizes
#      a zero-touch install, which this script re-verifies itself by calling
#      `hadron-agent provision inspect-seed --require-auto-install` -- so even
#      if the unit's ExecCondition were bypassed, an unauthorized seed still
#      writes nothing.
#
# On a confirmed/authorized install it writes 99_hadron-agent-install.yaml (a
# Kairos cloud-config carrying the explicit install device, auto+reboot, the
# LOCKED `agent` user with only the approved supplemental groups, the Ly agent
# session, and hadron_agent.enabled=true) into /oem, then hands off to the
# install command.
#
# Overrides (testing / automation seams):
#   HADRON_INSTALL_CMD   install command to exec (default "kairos-agent install").
#                        This is the single seam through which a wipe happens;
#                        tests inject a fake here to assert did/didn't install.
#   HADRON_OEM_DIR       cloud-config output dir (default /oem).
#   HADRON_AGENT_BIN     hadron-agent binary for inspect-seed (default hadron-agent).
#   HADRON_SYS_BLOCK     block-device listing dir (default /sys/block).
#   HADRON_HOSTNAME      hostname used in --noninteractive mode (default hadron-agent).
set -eu

OEM_DIR="${HADRON_OEM_DIR:-/oem}"
OUT="$OEM_DIR/99_hadron-agent-install.yaml"
INSTALL_CMD="${HADRON_INSTALL_CMD:-kairos-agent install}"
AGENT_BIN="${HADRON_AGENT_BIN:-hadron-agent}"
SYS_BLOCK="${HADRON_SYS_BLOCK:-/sys/block}"

NONINTERACTIVE=0
for arg in "$@"; do
    case "$arg" in
        --noninteractive) NONINTERACTIVE=1 ;;
        *) printf 'hadron-agent-install: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

# Colours as LITERAL escape sequences (16-colour VT; no truecolor on the install
# console). Built once so output uses plain printf and never reinterprets a
# message as a format string.
E=$(printf '\033')
R="${E}[0m"; DIM="${E}[0;90m"; B="${E}[1m"
CYAN="${E}[1;36m"; MAG="${E}[1;35m"; GREEN="${E}[1;32m"; RED="${E}[1;31m"

say()  { printf '%s\n' "$*" >&2; }
err()  { printf '%s\n' "${RED}  !!${R} $*" >&2; }
step() { printf '\n%s\n' "${MAG}[$1]${R} ${B}$2${R}" >&2; }

# list_disks: echo "<dev> <sizeGB>" per candidate whole disk.
list_disks() {
    for _d in "$SYS_BLOCK"/*; do
        [ -e "$_d" ] || continue
        _n=$(basename "$_d")
        case "$_n" in loop*|sr*|ram*|fd*|dm-*) continue ;; esac
        _sectors=$(cat "$_d/size" 2>/dev/null || echo 0)
        [ "$_sectors" -gt 0 ] 2>/dev/null || continue
        _gb=$(( _sectors / 2 / 1024 / 1024 ))
        printf '/dev/%s %s\n' "$_n" "$_gb"
    done
}

# pick_disk: interactive numbered menu -> /dev/<name> on stdout.
pick_disk() {
    _i=0; _names=""
    while read -r _dev _gb; do
        _i=$((_i + 1)); _names="$_names $_dev"
        printf '%s\n' "     ${CYAN}$_i)${R} $_dev   ${DIM}$_gb GB${R}" >&2
    done <<EOF
$(list_disks)
EOF
    [ "$_i" -gt 0 ] || { err "No installable disk found."; return 1; }
    while :; do
        printf '%s' "   ${GREEN}?${R} Install to which disk? ${DIM}[1-$_i]${R}: " >&2
        read -r _sel || return 1
        case "$_sel" in
            ''|*[!0-9]*) ;;
            *) if [ "$_sel" -ge 1 ] 2>/dev/null && [ "$_sel" -le "$_i" ] 2>/dev/null; then
                   echo "$_names" | cut -d' ' -f$((_sel + 1)); return 0
               fi ;;
        esac
        err "Pick a number between 1 and $_i."
    done
}

# write_config DEVICE HOSTNAME: materialize the cloud-config the install command
# consumes. Written with umask 077 (0600) so the transient config is not
# world-readable before the disk is provisioned.
write_config() {
    _dev="$1"; _host="$2"
    mkdir -p "$OEM_DIR"
    umask 077
    cat > "$OUT" <<EOF
#cloud-config
# Generated by hadron-agent-install ($(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo first-boot)).
install:
  device: "$_dev"
  auto: true
  reboot: true
  # The agent appliance ships NO admin/sudo user by design -- the locked, non-
  # admin 'agent' account is (re)created by the 90_agent_profile OEM stage on the
  # installed system. Kairos 3.3.x refuses to install without an admin-group user
  # unless nousers is set, so opt in explicitly: the appliance is intentionally
  # user-locked and never grants interactive sudo.
  nousers: true
hostname: "$_host"
users:
  - name: "agent"
    lock_passwd: true
    groups: [audio, video, render, input, bluetooth, seat, hadron-agent-control]
hadron_agent:
  enabled: true
stages:
  initramfs:
    - name: "Hadron agent default session"
      files:
        - path: /etc/ly/save.ini
          permissions: 0644
          content: |
            user = agent
            session = i3
EOF
}

# ---------------------------------------------------------------------------
# NON-INTERACTIVE: seed-gated zero-touch install.
# ---------------------------------------------------------------------------
if [ "$NONINTERACTIVE" = "1" ]; then
    # Re-verify authorization ourselves and read the authorized device from the
    # seed. inspect-seed prints ONLY the /dev path on success and exits non-zero
    # when the seed does not fully authorize (auto+device+enabled). If it does
    # not authorize, we write nothing and DO NOT install.
    if ! DEVICE=$("$AGENT_BIN" provision inspect-seed --require-auto-install --oem-dir "$OEM_DIR"); then
        err "seed does not authorize a zero-touch install; not installing."
        exit 1
    fi
    DEVICE=$(printf '%s' "$DEVICE" | tr -d '[:space:]')
    case "$DEVICE" in
        /dev/?*) ;;
        *) err "inspect-seed returned an invalid device (${DEVICE:-empty}); not installing."; exit 1 ;;
    esac
    HOSTNAME_VAL="${HADRON_HOSTNAME:-hadron-agent}"
    write_config "$DEVICE" "$HOSTNAME_VAL"
    say ""
    say "${GREEN}==>${R} Zero-touch install authorized; installing agent to ${B}$DEVICE${R} ..."
    exec $INSTALL_CMD
fi

# ---------------------------------------------------------------------------
# AUTO (provisioning ISO): the agent appliance is provisioned by building the
# ISO with `auroraboot --cloud-config <cfg>`. AuroraBoot writes that config to
# the ISO root as /config.yaml, which on a livecd/install boot is mounted at
# /run/initramfs/live/config.yaml -- one of the dirs `kairos-agent install`
# itself scans (kairos GetUserConfigDirs: /run/initramfs/live, /etc/kairos,
# /usr/local/cloud-config, /oem). When the merged config authorizes a zero-touch
# install (install.auto=true + install.device + hadron_agent.enabled), install
# unattended -- this is the agent ISO's expected purpose. A plain agent ISO with
# no such config falls through to the interactive installer below (the manual
# fallback, shipped as a separate ISO built without --cloud-config).
#
# inspect-seed parses a single directory of *.yaml; assemble one from the same
# dirs kairos scans (writable last so a datasource/oem config can override) so
# the embedded --cloud-config is included and the same authoritative parser
# decides authorization.
# ---------------------------------------------------------------------------
_scan=$(mktemp -d)
_seq=0
for _d in ${HADRON_CONFIG_DIRS:-/run/initramfs/live /etc/kairos /usr/local/cloud-config "$OEM_DIR"}; do
    for _f in "$_d"/*.yaml "$_d"/*.yml; do
        [ -e "$_f" ] || continue
        _seq=$((_seq + 1))
        cp -f "$_f" "$_scan/$(printf '%03d' "$_seq")_$(basename "$_f")" 2>/dev/null || true
    done
done
if DEVICE=$("$AGENT_BIN" provision inspect-seed --require-auto-install --oem-dir "$_scan" 2>/dev/null); then
    DEVICE=$(printf '%s' "$DEVICE" | tr -d '[:space:]')
    case "$DEVICE" in
        /dev/?*)
            rm -rf "$_scan"
            HOSTNAME_VAL="${HADRON_HOSTNAME:-hadron-agent}"
            write_config "$DEVICE" "$HOSTNAME_VAL"
            say ""
            say "${GREEN}==>${R} Provisioning config authorizes zero-touch install to ${B}$DEVICE${R}; installing ..."
            exec $INSTALL_CMD
            ;;
    esac
fi
rm -rf "$_scan"

# ---------------------------------------------------------------------------
# INTERACTIVE: ask hostname + disk, confirm with a typed `yes`.
# ---------------------------------------------------------------------------
if [ ! -t 0 ] && [ "${HADRON_INSTALL_ALLOW_NOTTY:-0}" != "1" ]; then
    err "No terminal on stdin. The interactive installer must run on a console."
    err "Zero-touch install is only available via --noninteractive with an authorized seed."
    exit 1
fi

# Loop the whole wizard: any non-confirmation re-asks instead of dead-ending the
# installer service. EOF on any read aborts WITHOUT writing a disk.
while :; do
    printf '\033[2J\033[H' >&2 2>/dev/null || true
    say ""
    say "   ${CYAN}+-------------------------------------------+${R}"
    say "   ${CYAN}|${R}   ${B}H A D R O N${R}   ${DIM}-${R}   agent appliance installer   ${CYAN}|${R}"
    say "   ${CYAN}+-------------------------------------------+${R}"
    say ""
    say "   ${DIM}This installs the Cua agent appliance to a disk and reboots.${R}"

    step 1 "Hostname"
    printf '%s' "   ${GREEN}?${R} Hostname ${DIM}[hadron-agent]${R}: " >&2
    read -r HOSTNAME_VAL || { say ""; err "Aborted (no input); nothing was written."; exit 1; }
    [ -n "$HOSTNAME_VAL" ] || HOSTNAME_VAL="hadron-agent"

    step 2 "Target disk"
    say "   ${DIM}The selected disk will be ERASED.${R}"
    DISK=$(pick_disk) || { say ""; err "Aborted at disk selection; nothing was written."; exit 1; }

    step 3 "Confirm"
    say "   ${B}Hostname${R}    : $HOSTNAME_VAL"
    say "   ${B}User${R}        : agent ${DIM}(locked; groups: audio video render input bluetooth seat hadron-agent-control)${R}"
    # The EXACT selected device, in RED, so the operator sees precisely what is
    # about to be erased before they can confirm.
    say "   ${B}Install to${R}  : ${RED}${B}$DISK${R}${RED}  (ALL DATA ERASED)${R}"
    say ""
    printf '%s' "   ${GREEN}?${R} Type ${B}yes${R} to erase ${RED}$DISK${R} and install (anything else starts over): " >&2
    read -r ANS || { say ""; err "Aborted (no input); nothing was written."; exit 1; }
    if [ "$ANS" = "yes" ]; then
        break
    fi
    say ""; err "Not confirmed (you must type exactly 'yes') -- starting over."
    sleep 1 2>/dev/null || true
done

write_config "$DISK" "$HOSTNAME_VAL"
say ""
say "${GREEN}==>${R} Installing agent appliance (${B}$HOSTNAME_VAL${R}) to ${B}$DISK${R} ..."
exec $INSTALL_CMD
