// hadron-updated asks polkit without interaction, so every answer here is a
// plain yes or no: members of admin may install updates and system
// extensions, reboot, and manage the disk recovery key; nobody else may,
// whatever the session.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("io.kairos.hadron-update.") == 0) {
        return subject.isInGroup("admin") ? polkit.Result.YES : polkit.Result.NO;
    }
});
