#!/bin/sh
# Keep every human user's persistent Flathub remote signed and canonical.
set -u

FLATHUB_NAME=flathub
FLATHUB_URL=https://dl.flathub.org/repo/
FLATHUB_DESCRIPTOR=/usr/share/hadron/flathub.flatpakrepo
FLATHUB_KEY=/usr/share/hadron/flathub.gpg
FLATHUB_FINGERPRINT=6E5C05D979C76DAF93C081354184DD4D907A7CAE
FLATHUB_DESCRIPTOR_SHA256=3371dd250e61d9e1633630073fefda153cd4426f72f4afa0c3373ae2e8fea03a
FLATHUB_KEY_SHA256=8bdc20abc4e19c0796460beb5bfe0e7aa4138716999e19c6f2dbdd78cc41aeaa

gpg_home=

cleanup_gpg_home() {
    if [ -n "$gpg_home" ]; then
        rm -rf "$gpg_home"
        gpg_home=
    fi
}

trap cleanup_gpg_home 0
trap 'cleanup_gpg_home; exit 1' HUP INT TERM

remote_details() {
    su - "$1" -c \
        'flatpak --user remotes --show-disabled --columns=name,url,options'
}

discover_remote() {
    if ! details=$(remote_details "$1"); then
        return 2
    fi
    if printf '%s\n' "$details" | awk -F '\t' \
        '$1 == "flathub" { found=1 } END { exit !found }'; then
        return 0
    fi
    return 1
}

assert_remote_state() {
    user=$1
    expected=$2
    if ! details=$(remote_details "$user"); then
        return 1
    fi
    printf '%s\n' "$details" | awk -F '\t' \
        -v expected="$expected" -v url="$FLATHUB_URL" '
        $1 == "flathub" {
            found=1
            if ($2 != url || $3 ~ /(^|,)no-gpg-verify(,|$)/) bad=1
            if (expected == "disabled" &&
                $3 !~ /(^|,)disabled(,|$)/) bad=1
            if (expected == "enabled" &&
                $3 ~ /(^|,)disabled(,|$)/) bad=1
        }
        END { exit (!found || bad) }
    '
}

disable_remote() {
    su - "$1" -c 'flatpak --user remote-modify --disable flathub'
}

assert_remote_disabled() {
    if ! details=$(remote_details "$1"); then
        return 1
    fi
    printf '%s\n' "$details" | awk -F '\t' '
        $1 == "flathub" {
            found=1
            if ($3 !~ /(^|,)disabled(,|$)/) bad=1
        }
        END { exit (!found || bad) }
    '
}

assert_no_enabled_remote() {
    if ! details=$(remote_details "$1"); then
        return 1
    fi
    printf '%s\n' "$details" | awk -F '\t' '
        $1 == "flathub" && $3 !~ /(^|,)disabled(,|$)/ { bad=1 }
        END { exit bad }
    '
}

bootstrap_assets_valid() {
    if ! printf '%s  %s\n%s  %s\n' \
        "$FLATHUB_DESCRIPTOR_SHA256" "$FLATHUB_DESCRIPTOR" \
        "$FLATHUB_KEY_SHA256" "$FLATHUB_KEY" | sha256sum -c -; then
        return 1
    fi

    gpg_home=$(mktemp -d /run/hadron-user-setup-gpg.XXXXXX) || {
        gpg_home=
        return 1
    }
    if ! chmod 700 "$gpg_home"; then
        cleanup_gpg_home
        return 1
    fi
    if ! key_details=$(GNUPGHOME="$gpg_home" gpg --batch --with-colons \
        --show-keys "$FLATHUB_KEY" 2>/dev/null); then
        cleanup_gpg_home
        return 1
    fi
    fingerprints=$(printf '%s\n' "$key_details" | awk -F: '
        $1 == "pub" { primary=1; next }
        primary && $1 == "fpr" { print $10; primary=0 }
    ')
    cleanup_gpg_home
    [ "$fingerprints" = "$FLATHUB_FINGERPRINT" ]
}

replace_remote_trust() {
    user=$1
    if ! details=$(remote_details "$user"); then
        return 1
    fi
    if ! printf '%s\n' "$details" | awk -F '\t' '
        $1 == "flathub" && $3 ~ /(^|,)disabled(,|$)/ { disabled=1 }
        END { exit !disabled }
    '; then
        return 1
    fi
    # libostree only supports additive imports, so replace this remote's keyring.
    if printf '%s\n' "$details" | awk -F '\t' -v url="$FLATHUB_URL" '
        $1 == "flathub" && $2 == url { canonical=1 }
        END { exit !canonical }
    '; then
        su - "$user" -c "
            flatpak_dir=\${FLATPAK_USER_DIR:-\${XDG_DATA_HOME:-\$HOME/.local/share}/flatpak}
            /usr/bin/rm -f \"\$flatpak_dir/repo/${FLATHUB_NAME}.trustedkeys.gpg\" &&
            /usr/bin/flatpak --user remote-modify \
                --gpg-import='$FLATHUB_KEY' --gpg-verify '$FLATHUB_NAME'
        "
        return
    fi
    su - "$user" -c "
        flatpak_dir=\${FLATPAK_USER_DIR:-\${XDG_DATA_HOME:-\$HOME/.local/share}/flatpak}
        /usr/bin/rm -f \"\$flatpak_dir/repo/${FLATHUB_NAME}.trustedkeys.gpg\" &&
        /usr/bin/flatpak --user remote-modify --url='$FLATHUB_URL' \
            --gpg-import='$FLATHUB_KEY' --gpg-verify '$FLATHUB_NAME'
    "
}

assert_remote_keys() {
    user=$1
    if ! key_details=$(su - "$user" -c "
        flatpak_dir=\${FLATPAK_USER_DIR:-\${XDG_DATA_HOME:-\$HOME/.local/share}/flatpak}
        LC_ALL=C /usr/bin/ostree --repo=\"\$flatpak_dir/repo\" \
            remote gpg-list-keys '$FLATHUB_NAME'
    "); then
        return 1
    fi
    fingerprints=$(printf '%s\n' "$key_details" | awk '
        $1 == "Key:" { print $2 }
    ')
    [ "$fingerprints" = "$FLATHUB_FINGERPRINT" ]
}

leave_disabled() {
    if ! disable_remote "$1"; then
        echo "hadron-user-setup: unable to disable failed flathub remote for $1" >&2
    fi
    if ! assert_no_enabled_remote "$1"; then
        echo "hadron-user-setup: unable to verify disabled flathub remote for $1" >&2
    fi
    return 1
}

configure_remote() {
    user=$1
    discover_remote "$user"
    discovery=$?
    if [ "$discovery" -eq 2 ]; then
        leave_disabled "$user"
        return 1
    fi
    if [ "$discovery" -eq 0 ]; then
        if ! disable_remote "$user"; then
            leave_disabled "$user"
            return 1
        fi
        if ! assert_remote_disabled "$user" ||
           ! bootstrap_assets_valid ||
           ! replace_remote_trust "$user" ||
           ! assert_remote_state "$user" disabled ||
           ! assert_remote_keys "$user"; then
            leave_disabled "$user"
            return 1
        fi
        if ! su - "$user" -c \
            "flatpak --user remote-modify --enable '$FLATHUB_NAME'" ||
           ! assert_remote_state "$user" enabled; then
            leave_disabled "$user"
            return 1
        fi
        return 0
    fi

    if ! bootstrap_assets_valid || ! su - "$user" -c \
        "flatpak --user remote-add '$FLATHUB_NAME' '$FLATHUB_DESCRIPTOR'" ||
       ! assert_remote_state "$user" enabled ||
       ! assert_remote_keys "$user"; then
        leave_disabled "$user"
        return 1
    fi
}

status=0
while IFS=: read -r user password uid gid gecos home shell; do
    case "$uid" in
        ''|*[!0-9]*) continue ;;
    esac
    if [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] &&
       ! configure_remote "$user"; then
        echo "hadron-user-setup: signed Flathub setup failed for $user" >&2
        status=1
    fi
done < /etc/passwd
exit "$status"
