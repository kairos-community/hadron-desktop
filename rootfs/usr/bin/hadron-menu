#!/bin/sh
# The Hadron menu, on Super+Escape in every variant: one place to reach the
# apps, the first-run app picker, Wi-Fi, Bluetooth, audio, screenshots,
# emoji, the night light, clipboard history, updates, system extensions, the
# shortcut sheet and the power actions. The picker is hadron-pick (fuzzel on Wayland, dmenu on
# i3). Each entry opens what the variant already uses for it: the hadron-*
# menus on sway and i3, Noctalia's panels on niri, COSMIC Settings and
# cosmic-osd on COSMIC. Emoji opens hadron-emoji on every variant.
#
# Updates and system extensions go through hadron-update in a terminal, as
# the update icon does: the update service and polkit decide who may install
# (the admin group).

# DESKTOP_NAME (Sway, i3, niri, COSMIC) and TERMINAL_EXEC, the terminal to
# run a command in, split on spaces.
DESKTOP_NAME="" TERMINAL_EXEC=""
# shellcheck disable=SC1091
[ -r /etc/hadron-desktop/session ] && . /etc/hadron-desktop/session
FLAVOR=""
[ -r /etc/hadron-desktop/release ] && FLAVOR=$(sed -n 's/^FLAVOR=//p' /etc/hadron-desktop/release)
if [ -z "$TERMINAL_EXEC" ]; then
    # The agent image's session file sets no terminal; it is i3.
    case "$DESKTOP_NAME" in
        i3)    TERMINAL_EXEC="st -c HadronFloat -e" ;;
        COSMIC) TERMINAL_EXEC="cosmic-term -e" ;;
        *)     TERMINAL_EXEC="foot --app-id=floatterm" ;;
    esac
fi

pick() { hadron-pick "$@"; }

# term CMD: run a shell command in the session's terminal, in the background.
term() {
    # shellcheck disable=SC2086 # TERMINAL_EXEC is split on spaces on purpose.
    $TERMINAL_EXEC sh -c "$1" >/dev/null 2>&1 &
}

# The fuzzel or dmenu window must be gone before a whole-screen capture.
settle() { sleep 0.3; }

apps() {
    case "$DESKTOP_NAME" in
        Sway)   exec fuzzel ;;
        niri)   exec noctalia msg panel-open launcher ;;
        COSMIC) exec cosmic-launcher ;;
        # i3 (and the agent image): the installed apps by name, as on Super+D.
        *)      exec hadron-apps ;;
    esac
}

# panel WHAT: Wi-Fi, Bluetooth and audio, each the way the variant shows it.
panel() {
    case "$DESKTOP_NAME" in
        niri)
            case "$1" in wifi) tab=network ;; *) tab=$1 ;; esac
            exec noctalia msg panel-open control-center "$tab" ;;
        COSMIC)
            case "$1" in wifi) page=wireless ;; audio) page=sound ;; *) page=$1 ;; esac
            exec cosmic-settings "$page" ;;
        *)  exec "hadron-$1-menu" ;;
    esac
}

capture() {
    what=$(printf '%s\n' "Whole screen" "Area or window" | pick Capture 2) || exit 0
    case "$DESKTOP_NAME:$what" in
        Sway:Whole*)   settle; grim - | wl-copy ;;
        Sway:Area*)    g=$(slurp) || exit 0; grim -g "$g" - | wl-copy ;;
        niri:Whole*)   settle; exec niri msg action screenshot-screen ;;
        niri:Area*)    exec niri msg action screenshot ;;
        COSMIC:Whole*) settle; exec cosmic-screenshot --interactive=false ;;
        COSMIC:Area*)  exec cosmic-screenshot ;;
        *:Whole*)      settle; exec hadron-screenshot ;;
        *:Area*)       exec hadron-screenshot area ;;
    esac
}

update() {
    pause='printf "\nPress Enter to close."; read -r _'
    items="Check for updates
Install the latest release"
    # The agent image has no update service, and the CLI refuses a rollback
    # there with the commands to run by hand.
    [ "$FLAVOR" = agent ] || items="$items
Restart into the previous system"
    what=$(printf '%s\n' "$items" | pick Update 3) || exit 0
    case "$what" in
        Check*)   term "hadron-update status; $pause" ;;
        Install*) term "hadron-update upgrade --pause-on-error" ;;
        Restart*) term "hadron-update rollback || { $pause; }" ;;
    esac
}

# extensions: the catalogs' system extensions, ✓ on the installed ones.
# Picking one installs or removes it in a terminal, where hadron-ext shows
# what it is and asks first. The tray's "Extensions…" opens this entry.
extensions() {
    pause='printf "\nPress Enter to close."; read -r _'
    # Without the service or the network, show why in a terminal.
    list=$(hadron-ext browse --menu 2>/dev/null) || { term "hadron-ext browse; $pause"; exit 0; }
    [ -n "$list" ] || { term "hadron-ext browse; $pause"; exit 0; }
    n=$(printf '%s\n' "$list" | wc -l)
    [ "$n" -le 12 ] || n=12
    sel=$(printf '%s\n' "$list" | pick Extensions "$n") || exit 0
    case "$sel" in
        "Install from a URL…") term "hadron-ext install -; $pause"; exit 0 ;;
    esac
    # "✓ name — description" or "  name — description". The name is checked
    # before it reaches the shell command: the catalog could hold anything.
    name=$(printf '%s\n' "$sel" | sed 's/^✓//' | awk '{ print $1 }')
    case "$name" in
        ''|-*|*[!A-Za-z0-9._+-]*) exit 0 ;;
    esac
    case "$sel" in
        ✓*) term "hadron-ext remove $name; $pause" ;;
        *)  term "hadron-ext install $name; $pause" ;;
    esac
}

help_sheet() {
    case "$DESKTOP_NAME" in
        Sway)   exec foot --app-id=floatterm -T "Keyboard shortcuts" hadron-help ;;
        niri)   exec foot --app-id=floatterm -W 96x30 -T "Keyboard shortcuts" hadron-help ;;
        i3)     exec st -c HadronFloat -t "Keyboard shortcuts" -e hadron-help ;;
        *)      term hadron-help ;;
    esac
}

power() {
    case "$DESKTOP_NAME" in
        niri)   exec noctalia msg panel-open session ;;
        COSMIC)
            what=$(printf '%s\t%s\n' Lock 󰌾 "Log out" 󰍃 Suspend 󰒲 Restart 󰜉 \
                "Power off" 󰐥 | pick Power 5) || exit 0
            case "$what" in
                Lock)        exec loginctl lock-session ;;
                "Log out")   exec cosmic-osd log-out ;;
                Suspend)     exec systemctl suspend ;;
                Restart)     exec cosmic-osd restart ;;
                "Power off") exec cosmic-osd shutdown ;;
            esac ;;
        *)      exec hadron-power-menu ;;
    esac
}

# An entry name as the argument opens it directly (`hadron-menu Help` is what
# the welcome notification runs when clicked).
# Each entry is "Label<TAB>icon"; hadron-pick shows the icon in fuzzel only.
# "Install apps" reopens the first-run app picker. The agent image ships
# neither it, the clipboard history nor hadron-ext (Dockerfile.agent removes
# them).
tab=$(printf '\t')
entries="Apps${tab}󰀻"
command -v hadron-first-run-apps >/dev/null 2>&1 && entries="$entries
Install apps${tab}󰏗"
entries="$entries
Wi-Fi${tab}󰖩
Bluetooth${tab}󰂯
Audio${tab}󰕾
Capture${tab}󰄀
Emoji${tab}󰞅"
# COSMIC has no night light (see hadron-night-light), so no entry there.
[ "$DESKTOP_NAME" = COSMIC ] || entries="$entries
Night light${tab}󰖔"
command -v hadron-clipboard >/dev/null 2>&1 && entries="$entries
Clipboard${tab}󰅍"
entries="$entries
Update${tab}󰚰"
command -v hadron-ext >/dev/null 2>&1 && entries="$entries
Extensions${tab}󰏓"
# The disk recovery key, on an encrypted disk: the installer's marker, or a
# Trusted Boot system, whose disk is always sealed to the TPM. The agent image
# ships no hadron-recovery (Dockerfile.agent removes it).
if command -v hadron-recovery >/dev/null 2>&1 &&
    { [ -e /etc/hadron-desktop/encryption ] || grep -q rd.immucore.uki /proc/cmdline 2>/dev/null; }; then
    entries="$entries
Recovery key${tab}󰌆"
fi
entries="$entries
Help${tab}󰌌
Power${tab}󰐥"
n=$(printf '%s\n' "$entries" | wc -l)
if [ $# -gt 0 ]; then
    sel=$1
else
    sel=$(printf '%s\n' "$entries" | pick Hadron "$n") || exit 0
fi
case "$sel" in
    Apps)      apps ;;
    "Install apps") exec hadron-first-run-apps ;;
    Wi-Fi)     panel wifi ;;
    Bluetooth) panel bluetooth ;;
    Audio)     panel audio ;;
    Capture)   capture ;;
    Emoji)     exec hadron-emoji ;;
    "Night light") exec hadron-night-light toggle ;;
    Clipboard) exec hadron-clipboard ;;
    Update)    update ;;
    Extensions) extensions ;;
    "Recovery key") term "hadron-recovery; printf '\nPress Enter to close.'; read -r _" ;;
    Help)      help_sheet ;;
    Power)     power ;;
esac
