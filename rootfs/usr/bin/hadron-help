#!/bin/sh
# Keyboard shortcut cheat sheet, opened with Super+F1 (and mentioned in the
# first-login welcome notification). Shared by the variants.
#
#   hadron-help            show the sheet in a pager
#   hadron-help --search   pick a shortcut from a searchable list (hadron-pick)
#   hadron-help --text     print the sheet to stdout, no colour, no pager
#
# The key rows are not written here. tools/gen-shortcuts.py builds
# /usr/share/hadron/shortcuts.txt for the variant from its real config (sway,
# i3, niri) or, for COSMIC, from a short hand-kept list, and CI fails when the
# committed file is stale. Each row is: SECTION <tab> KEYS <tab> DESCRIPTION.
# Keys are ASCII on purpose: awk pads by bytes, so a multi-byte character in
# the key column would push its description out of line.
sheet=${HADRON_SHORTCUTS:-/usr/share/hadron/shortcuts.txt}

if [ ! -r "$sheet" ]; then
    echo "hadron-help: no shortcut list at $sheet" >&2
    exit 1
fi

# The rows that are commands, not keys, after the key sections.
software() {
    printf 'Software\t%s\t%s\n' \
        "flatpak install flathub <app>" "install a desktop app" \
        "distrobox create / enter" "a mutable Linux to tinker in" \
        "hadron-update" "check for a new Hadron Desktop release" \
        "hadron-update upgrade" "install it (applies on the next boot)"
    # System extensions; the agent image has none (Dockerfile.agent).
    command -v hadron-ext >/dev/null 2>&1 && printf 'Software\t%s\t%s\n' \
        "hadron-ext browse" "host software (VPN, firmware) from the catalogs" \
        "hadron-ext install <name>" "add it to /usr, checked first (admin only)"
    return 0
}

rows() { { grep -v '^#' "$sheet"; software; }; }

# render COLOUR: the sections of rows(), one heading per change of section.
render() {
    rows | awk -F '\t' -v colour="$1" '
        BEGIN {
            if (colour) { b = "\033[1;34m"; c = "\033[36m"; d = "\033[2m"; r = "\033[0m" }
            w = 34
        }
        { sec[NR] = $1; key[NR] = $2; desc[NR] = $3; if (length($2) > w) w = length($2) }
        END {
            printf "%sHadron Desktop%s  %sSuper is the Windows / Command key%s\n", b, r, d, r
            for (i = 1; i <= NR; i++) {
                if (sec[i] != last) { printf "\n%s%s%s\n", b, sec[i], r; last = sec[i] }
                printf "  %s%-" w "s%s %s\n", c, key[i], r, desc[i]
            }
        }'
}

case "${1:-}" in
    --search)
        # One line per shortcut, "keys  description", for the picker to filter.
        # Choosing a line only closes the picker: there is nothing to run.
        rows | awk -F '\t' '{ printf "%-34s  %s\n", $2, $3 }' |
            hadron-pick "Shortcuts" 16 >/dev/null
        exit 0 ;;
    --text)
        render 0
        exit 0 ;;
    "") ;;
    *)
        echo "usage: hadron-help [--search | --text]" >&2
        exit 2 ;;
esac

{
render 1
printf "\n\033[2mPress q to close. Search: hadron-help --search\033[0m\n"
} | less -R
