# dunst notifications for the i3 variant: the Isotope palette.
# Colours: generated from theme/palette.toml by tools/gen-theme.py.
[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 180
    origin = top-right
    offset = 14x42
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 10
    progress_bar_corner_radius = 4
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#e9e7c1"
    separator_color = frame
    font = Inter Variable 10.5
    icon_theme = Conflux
    enable_recursive_icon_lookup = true
    markup = full
    format = "<b>%s</b>\n%b"
    corner_radius = 10
    timeout = 6
    # A click runs the notification's default action (the welcome opens the
    # shortcut sheet), then closes it.
    mouse_left_click = do_action, close_current

[urgency_low]
    background = "#141411"
    foreground = "#ced0c8"
    highlight = "#e9e7c1"

[urgency_normal]
    background = "#141411"
    foreground = "#f4f5f2"
    highlight = "#e9e7c1"

[urgency_critical]
    background = "#141411"
    foreground = "#ff7172"
    highlight = "#ff7172"
    frame_color = "#ff7172"
    timeout = 0
