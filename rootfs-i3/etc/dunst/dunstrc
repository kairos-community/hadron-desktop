[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 180
    origin = top-right
    offset = 14x42
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 10
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    font = DejaVu Sans 10
    markup = full
    format = "<b>%s</b>\n%b"
    corner_radius = 10
    timeout = 6

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
