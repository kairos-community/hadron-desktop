#!/bin/sh
# Read a secret in a temporary st window and return it on stdout. dmenu has no
# password mode, so Wi-Fi credentials should not be entered into dmenu itself.
set -eu
prompt=${1:-Password}
umask 077
dir=$(mktemp -d "${TMPDIR:-/tmp}/hadron-secret.XXXXXX")
fifo=$dir/value
mkfifo "$fifo"
trap 'rm -rf "$dir"' EXIT HUP INT TERM

st -c HadronFloat -t Password -e sh -c '
    trap "stty echo 2>/dev/null || true" EXIT HUP INT TERM
    printf "%s: " "$1"
    stty -echo
    IFS= read -r secret
    stty echo
    printf "\n"
    printf "%s\n" "$secret" > "$2"
' sh "$prompt" "$fifo" &

IFS= read -r secret < "$fifo"
wait "$!" 2>/dev/null || true
printf '%s' "$secret"
