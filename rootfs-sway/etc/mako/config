# mako notifications for the Sway variant: the Isotope palette.
# Colours: generated from theme/palette.toml by tools/gen-theme.py.
font=Inter Variable 10.5
background-color=#141411f2
text-color=#f4f5f2
border-color=#8fd12e
progress-color=over #8fd12e55
border-size=2
border-radius=10
width=360
padding=12
margin=10
default-timeout=6000
max-visible=5
anchor=top-right

# Do not disturb (isotope-notify-key dnd): nothing is shown; the notifications
# are kept and appear when the mode is turned off.
[mode=do-not-disturb]
invisible=1

[urgency=high]
border-color=#ff857a
default-timeout=0

# Critical notifications still show in do not disturb.
[mode=do-not-disturb urgency=high]
invisible=0
