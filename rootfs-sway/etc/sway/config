# Sway config for Hadron Desktop — Tokyo Night, sane defaults.
# A usable out-of-the-box setup: gaps, workspaces, media keys, screenshots.

### Variables ##############################################################
set $mod   Mod4
set $term  foot
set $menu  fuzzel
set $left  h
set $down  j
set $up    k
set $right l

# Hadron palette. Generated from theme/palette.toml by tools/gen-theme.py:
# edit the palette, not these values. Inactive titles and workspace labels use
# $dim, not the darker decoration grey, so they stay readable.
set $bg      #1a1b26
set $bg_alt  #24283b
set $fg      #c0caf5
set $blue    #7aa2f7
set $cyan    #7dcfff
set $magenta #bb9af7
set $red     #f7768e
set $dim     #737aa2
set $border  #414868

### Appearance ############################################################
font pango:Inter Variable 10
default_border pixel 2
default_floating_border pixel 2
titlebar_padding 6 3
gaps inner 8
gaps outer 2
smart_gaps on
smart_borders on

# Adwaita cursors at 24 px; sway exports XCURSOR_THEME and XCURSOR_SIZE to
# the apps it starts.
seat * xcursor_theme Adwaita 24

# class                 border   bg       text   indicator child_border
client.focused          $blue    $bg      $fg    $cyan     $blue
client.focused_inactive $border  $bg      $dim   $border   $border
client.unfocused        $border  $bg      $dim   $border   $bg
client.urgent           $red     $red     $fg    $red      $red

# Wallpaper: the Hadron orbits, scaled to fill each output. The solid line
# first, because sway rejects an `output bg` whose file is missing (and swaybg
# paints the fallback colour only if a file it found will not load), so either
# way the desktop stays $bg rather than sway's grey.
output * bg $bg solid_color
output * bg /usr/share/backgrounds/hadron/hadron-orbits-night-3840x2160.png fill $bg

### Input #################################################################
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    scroll_method two_finger
}
input type:keyboard {
    xkb_options compose:ralt
}

### Autostart #############################################################
# Audio stack: PipeWire + WirePlumber for this session (drives wpctl, the media
# keys and waybar's volume module). Harmless if a user systemd unit already ran.
exec /usr/bin/pipewire
exec /usr/bin/wireplumber
exec mako
# Idle: lock after 5 minutes, turn the outputs off after 10. Also lock before
# suspend (-w makes logind wait until swaylock is up) and on
# `loginctl lock-session`. swaylock's colours are in /etc/swaylock/config.
exec swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' before-sleep 'swaylock -f' lock 'swaylock -f'
exec $term
# First-login welcome (once per user), and the update icon in waybar's tray,
# which shows when a new Hadron Desktop is out and installs it. Both use the
# session bus start-desktop opened.
exec hadron-welcome
exec hadron-update tray
# First-run app picker (a browser and essentials from Flathub), once per user,
# after the network is up; it runs in the background.
exec hadron-first-run-apps --login
# Night light (wlsunset), if the user turned it on in an earlier session.
exec hadron-night-light restore
# Clipboard history (Super+Ctrl+V): wl-paste gives each copy to cliphist.
exec hadron-clipboard daemon

### Key bindings ##########################################################
# help-row: Windows | Super + drag | Move a floating window with the mouse
floating_modifier $mod normal

# help-section: Basics
# help: Open a terminal
bindsym $mod+Return        exec $term
# help: Launch an application
bindsym $mod+d             exec $menu
# help: Close the focused window
bindsym $mod+Shift+q       kill
bindsym $mod+Shift+c       reload
# help: Power menu: log out, suspend, reboot, power off
bindsym $mod+Shift+e       exec hadron-power-menu
# help-section: System
# help: Lock the screen
bindsym $mod+Mod1+l        exec swaylock -f
# help-section: Basics
# help: This help
bindsym $mod+F1            exec foot --app-id=floatterm -T "Keyboard shortcuts" hadron-help
# help-section: Basics
# help: Clipboard history: copy an earlier entry again
bindsym $mod+Ctrl+v        exec hadron-clipboard
# The Hadron menu: apps, Wi-Fi, Bluetooth, audio, capture, update, help, power.
# help: Hadron menu: apps, Wi-Fi, Bluetooth, updates, power
bindsym $mod+Escape        exec hadron-menu
# Night light on and off: a warmer screen from 20:00 to 07:00.
# help-section: System
# help: Night light on and off
bindsym $mod+Mod1+n        exec hadron-night-light toggle
# The emoji picker: copies the chosen emoji to the clipboard.
# help-section: Basics
# help: Emoji picker: copies the chosen emoji
bindsym $mod+semicolon     exec hadron-emoji

# Focus
# help-section: Windows
# help+: Move focus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# Move windows
# help+: Move the window
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# Workspaces
# help-section: Workspaces
# help+: Switch to the numbered workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
# help+: Send the window to the numbered workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
# help-section: Windows
# help+: Stacked, tabbed or split layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
# help: Fullscreen
bindsym $mod+f fullscreen
# help: Float or tile the window
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resize mode
mode "resize" {
    bindsym $left  resize shrink width 30px
    bindsym $down  resize grow height 30px
    bindsym $up    resize shrink height 30px
    bindsym $right resize grow width 30px
    bindsym Left  resize shrink width 30px
    bindsym Down  resize grow height 30px
    bindsym Up    resize shrink height 30px
    bindsym Right resize grow width 30px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# help: Resize mode (arrows or H J K L, then Enter)
bindsym $mod+r mode "resize"

# Screenshots (grim + slurp + wl-clipboard)
# help-section: System
# help: Screenshot to the clipboard
bindsym Print       exec grim - | wl-copy
# help: Screenshot of an area
bindsym $mod+Print  exec grim -g "$(slurp)" - | wl-copy

# Hardware keys: volume (wpctl), screen brightness (logind) and playback
# (MPRIS), with the new level in a mako pop-up. They work on the lock screen.
bindsym --locked XF86AudioRaiseVolume  exec hadron-media-key volume-up
bindsym --locked XF86AudioLowerVolume  exec hadron-media-key volume-down
bindsym --locked XF86AudioMute         exec hadron-media-key mute
bindsym --locked XF86AudioMicMute      exec hadron-media-key mic-mute
bindsym --locked XF86MonBrightnessUp   exec hadron-media-key brightness-up
bindsym --locked XF86MonBrightnessDown exec hadron-media-key brightness-down
bindsym --locked XF86AudioPlay         exec hadron-media-key play-pause
bindsym --locked XF86AudioPause        exec hadron-media-key play-pause
bindsym --locked XF86AudioNext         exec hadron-media-key next
bindsym --locked XF86AudioPrev         exec hadron-media-key previous
bindsym --locked XF86AudioStop         exec hadron-media-key stop

### System control (no tray needed) #######################################
# Network: a fuzzel Wi-Fi picker over nmcli. Bluetooth: a fuzzel menu over
# bluetoothctl. Audio: fuzzel output switcher over wpctl (+ the media keys).
# help-section: System
# help: Wi-Fi
bindsym $mod+n       exec hadron-wifi-menu
# help: Audio output
bindsym $mod+Shift+a exec hadron-audio-menu
# help: Bluetooth
bindsym $mod+Shift+b exec hadron-bluetooth-menu
# Notifications (mako): close the newest, close all, show the last closed,
# do not disturb on/off.
# help-section: Notifications
# help: Close the newest notification
bindsym $mod+BackSpace       exec hadron-notify-key dismiss
# help: Close all notifications
bindsym $mod+Shift+BackSpace exec hadron-notify-key dismiss-all
# help: Show the last closed notification
bindsym $mod+Ctrl+BackSpace  exec hadron-notify-key restore
# help: Do not disturb on/off
bindsym $mod+Mod1+BackSpace  exec hadron-notify-key dnd
# floating "control" terminals (the shortcut sheet etc.), centered and sized
for_window [app_id="floatterm"] floating enable, resize set 820 520, move position center
for_window [app_id="floatterm" title="Keyboard shortcuts"] resize set 900 720, move position center

### Status bar ############################################################
# waybar (Tokyo Night) — config at /etc/xdg/waybar/{config,style.css}. Modules:
# workspaces, clock, network (click → hadron-wifi-menu), bluetooth, wireplumber
# (audio), cpu/memory/battery and an SNI system tray for applet icons.
bar {
    swaybar_command waybar
}

# Drop-ins for local overrides
include /etc/sway/config.d/*
