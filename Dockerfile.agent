ARG BASE_IMAGE=i3-desktop:dev
# Must match the Hadron release the i3 base image was built on (see the
# top-level Dockerfile); scripts/bump-hadron.sh keeps the two in step.
ARG HADRON_VERSION=v0.6.4
FROM ${BASE_IMAGE} AS xlibre-desktop
FROM rust:1.97.0-alpine3.22 AS rust-toolchain

# hadron-agent: the single static MCP service binary (Phase 2/3 Go module at
# agent/). go.mod/go.sum are copied and downloaded before the rest of the
# module source so an unrelated source edit does not invalidate the module
# cache layer.
FROM golang:1.25.0-alpine3.22 AS agent-gobuild
ARG VERSION=v0.0.0
ARG CUA_COMMIT=3cadb5f82e7d2ed071a2082764276ec872a52135
WORKDIR /src
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
# The version banner is read from internal/buildinfo (main reads
# buildinfo.Version/buildinfo.CuaRevision), not from package main.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath \
    -ldflags="-s -w -X github.com/mudler/hadron-desktop/agent/internal/buildinfo.Version=${VERSION} -X github.com/mudler/hadron-desktop/agent/internal/buildinfo.CuaRevision=${CUA_COMMIT}" \
    -o /out/hadron-agent ./cmd/hadron-agent

FROM ghcr.io/kairos-io/hadron-toolchain:${HADRON_VERSION} AS agent-native
# The desktop root has the canonical /usr/lib/firmware symlink while the
# toolchain has an empty directory at that path; normalize it before overlay.
RUN rmdir /usr/lib/firmware
COPY --from=xlibre-desktop /usr/include/ /usr/include/
COPY --from=xlibre-desktop /usr/lib/ /usr/lib/
# Xorg protocol packages install their pkg-config metadata under share rather
# than lib; the copied X11 .pc files depend on these records.
COPY --from=xlibre-desktop /usr/share/pkgconfig/ /usr/share/pkgconfig/
# Meson invokes GLib's generators while building the schemas, AT-SPI, and GTK.
# Keep the tools matched to the copied GLib libraries from the desktop image.
COPY --from=xlibre-desktop /usr/bin/glib-* /usr/bin/
COPY --from=xlibre-desktop /usr/bin/gdbus-codegen /usr/bin/gdbus-codegen
COPY --from=xlibre-desktop /usr/bin/gio-querymodules /usr/bin/gio-querymodules
COPY --from=xlibre-desktop /usr/bin/gdk-pixbuf-pixdata /usr/bin/gdk-pixbuf-pixdata
COPY --from=xlibre-desktop /usr/share/glib-2.0/codegen/ /usr/share/glib-2.0/codegen/
# Hadron and Alpine are both musl-based. Hadron intentionally omits the
# musl-utils ldconfig helper, so borrow the helper from the pinned Rust image.
COPY --from=rust-toolchain /sbin/ldconfig /sbin/ldconfig
# Alpine's helper returns the status of its final zero-argument test; make the
# no-argument form requested here a successful musl no-op.
RUN sed -i '$a exit 0' /sbin/ldconfig
RUN ldconfig
ENV PKG_CONFIG_PATH=/usr/lib/pkgconfig:/usr/share/pkgconfig
# renovate: datasource=gitlab-tags depName=xorg/lib/libxtst registryUrl=https://gitlab.freedesktop.org extractVersion=^libXtst-(?<version>\d+(\.\d+)*)$
ARG LIBXTST_VERSION=1.2.5
# renovate: datasource=gitlab-tags depName=GNOME/gsettings-desktop-schemas registryUrl=https://gitlab.gnome.org extractVersion=^(?<version>\d+(\.\d+)*)$
ARG GSETTINGS_SCHEMAS_VERSION=47.1
# renovate: datasource=gitlab-tags depName=GNOME/at-spi2-core registryUrl=https://gitlab.gnome.org extractVersion=^(?<version>\d+(\.\d+)*)$
ARG ATSPI_VERSION=2.54.0
# renovate: datasource=gitlab-tags depName=GNOME/gtk registryUrl=https://gitlab.gnome.org extractVersion=^(?<version>\d+(\.\d+)*)$
ARG GTK3_VERSION=3.24.43
ARG CUA_COMMIT=3cadb5f82e7d2ed071a2082764276ec872a52135


FROM agent-native AS agent-runtime-build
RUN pip3 install meson ninja packaging
RUN mkdir -p /agent-runtime /build && \
    install -Dm755 /sbin/ldconfig /agent-runtime/usr/bin/ldconfig
WORKDIR /build

# XTest is Cua's native foreground keyboard and pointer injection path on X11.
RUN curl --retry-all-errors -fL --retry 5 \
      https://xorg.freedesktop.org/archive/individual/lib/libXtst-${LIBXTST_VERSION}.tar.xz \
      -o libXtst.tar.xz && \
    tar -xf libXtst.tar.xz && \
    cd libXtst-${LIBXTST_VERSION} && \
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static && \
    make -j"$(nproc)" && \
    make install && \
    make install DESTDIR=/agent-runtime && \
    test -e /agent-runtime/usr/lib/libXtst.so.6

# The AT-SPI launcher reads these schemas to decide whether accessibility is
# enabled and which toolkit behavior to expose in the desktop session.
RUN SCHEMAS_SERIES="${GSETTINGS_SCHEMAS_VERSION%.*}" && \
    curl --retry-all-errors -fL --retry 5 \
      https://download.gnome.org/sources/gsettings-desktop-schemas/${SCHEMAS_SERIES}/gsettings-desktop-schemas-${GSETTINGS_SCHEMAS_VERSION}.tar.xz \
      -o gsettings-desktop-schemas.tar.xz && \
    tar -xf gsettings-desktop-schemas.tar.xz
WORKDIR /build/gsettings-desktop-schemas-${GSETTINGS_SCHEMAS_VERSION}
RUN meson setup build --prefix=/usr --libdir=lib --buildtype=release \
      -Dintrospection=false && \
    ninja -C build && \
    DESTDIR=/agent-runtime ninja -C build install

WORKDIR /build
RUN ATSPI_SERIES="${ATSPI_VERSION%.*}" && \
    curl --retry-all-errors -fL --retry 5 \
      https://download.gnome.org/sources/at-spi2-core/${ATSPI_SERIES}/at-spi2-core-${ATSPI_VERSION}.tar.xz \
      -o at-spi2-core.tar.xz && \
    tar -xf at-spi2-core.tar.xz
WORKDIR /build/at-spi2-core-${ATSPI_VERSION}
RUN meson setup build --prefix=/usr --libdir=lib --libexecdir=libexec \
      --buildtype=release -Ddefault_bus=dbus-daemon \
      -Ddbus_daemon=/usr/bin/dbus-daemon -Duse_systemd=true \
      -Dgtk2_atk_adaptor=false -Ddocs=false \
      -Dintrospection=disabled -Dx11=enabled
RUN ninja -C build
RUN ninja -C build install
RUN DESTDIR=/agent-runtime ninja -C build install
RUN test -x /agent-runtime/usr/libexec/at-spi-bus-launcher && \
    test -x /agent-runtime/usr/libexec/at-spi2-registryd && \
    test -e /agent-runtime/usr/lib/libatk-bridge-2.0.so.0 && \
    test -e /agent-runtime/usr/share/dbus-1/services/org.a11y.Bus.service && \
    test -e /agent-runtime/usr/share/dbus-1/accessibility-services/org.a11y.atspi.Registry.service && \
    test -e /agent-runtime/usr/lib/systemd/user/at-spi-dbus-bus.service

WORKDIR /build
RUN GTK_SERIES="${GTK3_VERSION%.*}" && \
    curl --retry-all-errors -fL --retry 5 \
      https://download.gnome.org/sources/gtk+/${GTK_SERIES}/gtk+-${GTK3_VERSION}.tar.xz \
      -o gtk.tar.xz && \
    tar -xf gtk.tar.xz
WORKDIR /build/gtk+-${GTK3_VERSION}
RUN meson setup build --prefix=/usr --libdir=lib --buildtype=release \
      -Dx11_backend=true -Dwayland_backend=false -Dbroadway_backend=false \
      -Dintrospection=false -Dgtk_doc=false -Dman=false \
      -Ddemos=false -Dexamples=false -Dtests=false \
      -Dprint_backends=file -Dcolord=no
RUN ninja -C build
RUN DESTDIR=/agent-runtime ninja -C build install


FROM agent-runtime-build AS cua-build
COPY --from=rust-toolchain /usr/local/cargo/ /usr/local/cargo/
COPY --from=rust-toolchain /usr/local/rustup/ /usr/local/rustup/
# The native toolchain defaults C builds to GCC LTO, which hides ring's C/ASM
# symbols from the Rust final link. Retain its size flags without cross-LTO.
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:${PATH} \
    RUSTFLAGS="-C target-feature=-crt-static" \
    CFLAGS="-Os -pipe -fomit-frame-pointer -fno-unroll-loops -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections" \
    LDFLAGS="-Wl,--gc-sections -Wl,--as-needed"
WORKDIR /build
RUN curl --retry-all-errors -fL --retry 5 \
      https://github.com/trycua/cua/archive/${CUA_COMMIT}.tar.gz \
      -o cua.tar.gz && \
    mkdir -p /build/cua && \
    tar -xzf cua.tar.gz --strip-components=1 -C /build/cua && \
    rm cua.tar.gz
RUN mkdir -p /cua/usr/bin && \
    cd /build/cua/libs/cua-driver/rust && \
    cargo build --locked -p cua-driver --release && \
    install -Dm755 target/release/cua-driver /cua/usr/bin/cua-driver && \
    /cua/usr/bin/cua-driver --version && \
    ldd /cua/usr/bin/cua-driver | tee /cua/ldd.txt && \
    ! grep -q 'not found' /cua/ldd.txt


FROM ${BASE_IMAGE} AS agent
ENV CUA_DRIVER_RS_TELEMETRY_ENABLED=false \
    CUA_DRIVER_RS_UPDATE_CHECK=false
COPY rootfs-agent/ /
COPY --from=agent-runtime-build /agent-runtime/ /
COPY --from=cua-build /cua/ /
COPY --from=agent-gobuild /out/hadron-agent /usr/bin/hadron-agent
# Identities for the opt-in appliance overlay only. hadron-agent-gateway is a
# locked, no-login system account that serves the public HTTPS MCP gateway;
# hadron-agent-control is a bare group used to gate the local control socket.
# The human `agent` account is intentionally NOT created here — it is created
# by the OEM/install paths (Task 5) on the live/installed system.
RUN groupadd -r hadron-agent-control && \
    groupadd -r hadron-agent-gateway && \
    useradd -r -M -N -g hadron-agent-gateway -s /usr/sbin/nologin \
      -c "Hadron agent gateway" hadron-agent-gateway && \
    chmod +x /usr/bin/hadron-agent && \
    glib-compile-schemas /usr/share/glib-2.0/schemas && \
    ldconfig && \
    ldd /usr/bin/cua-driver | tee /tmp/cua-ldd.txt && \
    ! grep -q 'not found' /tmp/cua-ldd.txt && \
    rm /tmp/cua-ldd.txt && \
    ! getent passwd agent
# The appliance upgrades along its own image line, not the i3 one it is built on.
RUN sed -i 's/^FLAVOR=.*/FLAVOR=agent/' /etc/hadron-desktop/release && \
    grep -qx 'FLAVOR=agent' /etc/hadron-desktop/release
# The label follows the file: inherited from the i3 base it would say `i3`.
LABEL io.kairos.hadron-desktop.flavor="agent"
# No update service: hadron-update upgrade keeps its direct sudo path on the
# appliance, so the root daemon, its D-Bus policy and activation, and its
# polkit action and rule from the i3 image go. The update icon that talks to
# it is shadowed by rootfs-agent/etc/i3/config.d/30-update-tray.conf.
RUN rm -f /usr/share/dbus-1/system.d/io.kairos.HadronUpdate1.conf \
      /usr/share/dbus-1/system-services/io.kairos.HadronUpdate1.service \
      /usr/lib/systemd/system/hadron-updated.service \
      /usr/share/polkit-1/actions/io.kairos.hadron-update.policy \
      /usr/share/polkit-1/rules.d/50-hadron-update.rules && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'hadron-update'
# No keyring: the appliance logs in automatically, so no password ever
# unlocks it, and there is no dialog that could. Without the Secret Service,
# apps use their own plain store, as before.
RUN rm -f /etc/systemd/user/sockets.target.wants/gnome-keyring-daemon.socket \
      /usr/lib/systemd/user/gnome-keyring-daemon.socket \
      /usr/lib/systemd/user/gnome-keyring-daemon.service \
      /usr/share/dbus-1/services/org.freedesktop.secrets.service \
      /usr/share/dbus-1/services/org.freedesktop.impl.portal.Secret.service \
      /usr/share/dbus-1/services/org.gnome.keyring.service \
      /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal \
      /usr/lib/security/pam_gnome_keyring.so && \
    ! ls /usr/share/dbus-1/services | grep -q -e secrets -e keyring
# No first-run app picker: the appliance is driven by an agent, not a person
# picking apps at first login. Remove the script and the i3 line that starts
# it; hadron-menu hides its entry when the script is missing.
RUN rm -f /usr/bin/hadron-first-run-apps && \
    sed -i '/hadron-first-run-apps/d' /etc/i3/config && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'hadron-first-run-apps'
# No clipboard history. An AI agent drives the appliance: a history would keep
# every token, password or key that the agent or a person copies, and give it
# back to anything that can run a command or read the screen, the agent
# itself included in a later, unrelated task. The i3 image's
# config.d/40-clipboard.conf (the recorder and Super+Ctrl+V) is shadowed by
# rootfs-agent's empty file; hadron-menu and hadron-help hide the entry when
# hadron-clipboard is gone.
RUN rm -f /usr/bin/hadron-clipboard /usr/bin/clipnotify && \
    ! grep -rhsv '^[[:space:]]*#' /etc/i3 /etc/xdg/autostart | grep -q 'hadron-clipboard'
# No system extensions. An appliance must not take root code from a menu: the
# hadron-ext command goes (hadron-menu and hadron-help hide it then), and so
# do its catalog list and the setting that merges unsigned extensions. Their
# polkit action went with the policy file above, and `hadron-update ext`
# refuses on the agent flavor.
RUN rm -f /usr/bin/hadron-ext /etc/hadron-desktop/extensions.conf /etc/kairos/90_hadron_extensions.yaml /system/oem/93_hadron_extensions.yaml && \
    ! test -e /usr/bin/hadron-ext
