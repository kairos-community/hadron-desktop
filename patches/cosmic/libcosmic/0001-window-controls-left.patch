+    /// Creates the window controls for the start of the header bar: close,
+    /// minimize and maximize, as round 12 px buttons in a neutral colour that
+    /// show their glyph only while the pointer is over them.
+    fn window_controls_left(&mut self) -> Element<'a, Message> {
+        let light = |name: &'static str, on_press: Message| {
+            widget::button::custom(widget::icon::from_name(name).icon().size(8))
+                .width(Length::Fixed(12.0))
+                .height(Length::Fixed(12.0))
+                .padding(2)
+                .class(theme::Button::Custom {
+                    active: Box::new(|_, theme| window_light_style(theme, Light::Active)),
+                    disabled: Box::new(|theme| window_light_style(theme, Light::Active)),
+                    hovered: Box::new(|_, theme| window_light_style(theme, Light::Hovered)),
+                    pressed: Box::new(|_, theme| window_light_style(theme, Light::Pressed)),
+                })
+                .on_press(on_press)
+        };
+
+        widget::row::with_capacity(3)
+            .push_maybe(
+                self.on_close
+                    .take()
+                    .map(|m| light("window-close-symbolic", m)),
+            )
+            .push_maybe(
+                self.on_minimize
+                    .take()
+                    .map(|m| light("window-minimize-symbolic", m)),
+            )
+            .push_maybe(self.on_maximize.take().map(|m| {
+                if self.maximized {
+                    light("window-restore-symbolic", m)
+                } else {
+                    light("window-maximize-symbolic", m)
+                }
+            }))
+            .spacing(6)
+            .padding([0, 6])
+            .align_y(iced::Alignment::Center)
+            .into()
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Light {
+    Active,
+    Hovered,
+    Pressed,
+}
+
+/// The look of a window control made by `window_controls_left`: a circle
+/// filled with the theme's neutral button colour and outlined with the
+/// divider colour; the glyph is transparent until hovered.
+fn window_light_style(theme: &crate::Theme, light: Light) -> widget::button::Style {
+    let cosmic = theme.cosmic();
+    let component = &cosmic.button;
+    let mut style = widget::button::Style::new();
+    let (background, glyph) = match light {
+        Light::Active => (component.base, iced_core::Color::TRANSPARENT),
+        Light::Hovered => (component.hover, component.on.into()),
+        Light::Pressed => (component.pressed, component.on.into()),
+    };
+    style.background = Some(iced_core::Background::Color(background.into()));
+    style.border_radius = 6.0_f32.into();
+    style.border_width = 1.0;
+    style.border_color = theme.current_container().component.divider.into();
+    style.icon_color = Some(glyph);
+    style.text_color = Some(glyph);
+    style
 }
 
