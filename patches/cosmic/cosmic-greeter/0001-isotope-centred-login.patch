diff -ruN a/src/greeter/background.rs b/src/greeter/background.rs
--- a/src/greeter/background.rs
+++ b/src/greeter/background.rs
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Isotope: the picture behind the login screen.
+//!
+//! The greeter shows the user's wallpaper. For Isotope's two desktop
+//! wallpapers it shows the soft copy the image build makes next to them
+//! (`isotope-desktop-{night,day}-blur.png`, tools/gen-wallpaper.py --blur),
+//! so the clock and the password field read on it. Any other picture is shown
+//! as it is, under a scrim of the theme's background colour.
+//!
+//! No dependencies beyond std, so `rustc --test` can test this file alone.
+
+use std::path::{Path, PathBuf};
+
+/// Where the image puts Isotope's wallpapers.
+pub const ISOTOPE_WALLPAPER_DIR: &str = "/usr/share/backgrounds/isotope";
+
+/// The stable names of the two desktop wallpapers. They are links to the
+/// release's (or a development build's) pictures, and cosmic-bg records the
+/// target, not the link, in its state, so a path is matched against both.
+pub const ISOTOPE_WALLPAPERS: [&str; 2] = ["isotope-desktop-night.png", "isotope-desktop-day.png"];
+
+/// The scrim's opacity over a picture that is not Isotope's.
+pub const SCRIM_ALPHA: f32 = 0.45;
+
+/// The picture to show for `wallpaper`, and whether to cover it with the scrim.
+pub fn greeter_background(wallpaper: &Path) -> (PathBuf, bool) {
+    greeter_background_with(wallpaper, |p| std::fs::canonicalize(p).ok())
+}
+
+/// [`greeter_background`] with the link resolution passed in, for the tests.
+pub fn greeter_background_with(
+    wallpaper: &Path,
+    resolve: impl Fn(&Path) -> Option<PathBuf>,
+) -> (PathBuf, bool) {
+    let dir = Path::new(ISOTOPE_WALLPAPER_DIR);
+    let resolved = resolve(wallpaper);
+    for name in ISOTOPE_WALLPAPERS {
+        let stable = dir.join(name);
+        let same = wallpaper == stable
+            || matches!((&resolved, resolve(&stable)), (Some(a), Some(b)) if *a == b);
+        if same {
+            let blur = format!("{}-blur.png", name.trim_end_matches(".png"));
+            return (dir.join(blur), false);
+        }
+    }
+    (wallpaper.to_path_buf(), true)
+}
+
+/// Isotope's system-wide cosmic-bg default (the `all` entry). A user who has
+/// never logged in has no cosmic-bg state, so the greeter shows this one.
+pub const SYSTEM_BACKGROUND_CONFIG: &str = "/usr/share/cosmic/com.system76.CosmicBackground/v1/all";
+
+/// The picture a cosmic-bg config entry names: its `source: Path("...")`.
+/// A colour source, or text that is not an entry, gives `None`.
+pub fn config_source(entry: &str) -> Option<PathBuf> {
+    let rest = &entry[entry.find("source:")? + "source:".len()..];
+    let rest = rest.trim_start().strip_prefix("Path")?.trim_start();
+    let rest = rest.strip_prefix('(')?.trim_start().strip_prefix('"')?;
+    let mut path = String::new();
+    let mut chars = rest.chars();
+    loop {
+        match chars.next()? {
+            '"' => break,
+            '\\' => match chars.next()? {
+                c @ ('"' | '\\') => path.push(c),
+                _ => return None,
+            },
+            c => path.push(c),
+        }
+    }
+    (!path.is_empty()).then(|| PathBuf::from(path))
+}
+
+/// The wallpaper for a user without one of their own (and before a user is
+/// chosen): the system default. When that is one of Isotope's two desktop
+/// wallpapers, the one that matches the theme, as `isotope wallpaper-follow`
+/// does on the desktop: night under a dark theme, day under a light one.
+pub fn default_wallpaper(system_default: Option<&Path>, is_dark: bool) -> Option<PathBuf> {
+    let source = system_default?;
+    let dir = Path::new(ISOTOPE_WALLPAPER_DIR);
+    let [night, day] = ISOTOPE_WALLPAPERS;
+    if source == dir.join(night) || source == dir.join(day) {
+        return Some(dir.join(if is_dark { night } else { day }));
+    }
+    Some(source.to_path_buf())
+}
+
+/// The fallback background: the picture to show, and whether it gets the
+/// scrim, for the system default config's text (`None` when it cannot be
+/// read). `None` means there is no system default; the greeter then keeps its
+/// built-in picture under the scrim.
+pub fn fallback_background(config: Option<&str>, is_dark: bool) -> Option<(PathBuf, bool)> {
+    let source = config.and_then(config_source);
+    default_wallpaper(source.as_deref(), is_dark).map(|p| greeter_background(&p))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// rootfs-cosmic/usr/share/cosmic/com.system76.CosmicBackground/v1/all
+    const ISOTOPE_ALL: &str = r#"(
+    output: "all",
+    source: Path("/usr/share/backgrounds/isotope/isotope-desktop-night.png"),
+    filter_by_theme: true,
+    rotation_frequency: 3600,
+    filter_method: Lanczos,
+    scaling_mode: Zoom,
+    sampling_method: Alphanumeric,
+)
+"#;
+
+    #[test]
+    fn the_system_config_names_the_night_wallpaper() {
+        assert_eq!(config_source(ISOTOPE_ALL), Some(PathBuf::from(NIGHT)));
+        assert_eq!(
+            config_source(r#"(output:"all",source:Path( "/a \"b\".png" ))"#),
+            Some(PathBuf::from(r#"/a "b".png"#))
+        );
+    }
+
+    #[test]
+    fn a_colour_or_broken_config_names_no_picture() {
+        assert_eq!(
+            config_source(r#"(output: "all", source: Color(Single((0.0, 0.0, 0.0))))"#),
+            None
+        );
+        assert_eq!(config_source(""), None);
+        assert_eq!(config_source(r#"(source: Path("/unterminated"#), None);
+        assert_eq!(config_source(r#"(source: Path(""))"#), None);
+    }
+
+    #[test]
+    fn a_user_without_a_wallpaper_gets_the_system_default_blurred() {
+        assert_eq!(
+            fallback_background(Some(ISOTOPE_ALL), true),
+            (Some((
+                PathBuf::from("/usr/share/backgrounds/isotope/isotope-desktop-night-blur.png"),
+                false
+            )))
+        );
+    }
+
+    #[test]
+    fn the_default_follows_a_light_theme_to_the_day_picture() {
+        assert_eq!(
+            fallback_background(Some(ISOTOPE_ALL), false),
+            Some((
+                PathBuf::from("/usr/share/backgrounds/isotope/isotope-desktop-day-blur.png"),
+                false
+            ))
+        );
+        assert_eq!(
+            default_wallpaper(Some(Path::new(DAY)), true),
+            Some(PathBuf::from(NIGHT))
+        );
+    }
+
+    #[test]
+    fn another_system_default_is_kept_under_the_scrim() {
+        let other = "(source: Path(\"/usr/share/backgrounds/cosmic/orion.jpg\"))";
+        assert_eq!(
+            fallback_background(Some(other), false),
+            Some((
+                PathBuf::from("/usr/share/backgrounds/cosmic/orion.jpg"),
+                true
+            ))
+        );
+    }
+
+    #[test]
+    fn no_system_default_means_no_fallback_picture() {
+        assert_eq!(fallback_background(None, true), None);
+        assert_eq!(fallback_background(Some("garbage"), true), None);
+    }
+
+    const NIGHT: &str = "/usr/share/backgrounds/isotope/isotope-desktop-night.png";
+    const DAY: &str = "/usr/share/backgrounds/isotope/isotope-desktop-day.png";
+
+    #[test]
+    fn isotope_wallpapers_get_their_blurred_copy_without_a_scrim() {
+        assert_eq!(
+            greeter_background(Path::new(NIGHT)),
+            (
+                PathBuf::from("/usr/share/backgrounds/isotope/isotope-desktop-night-blur.png"),
+                false
+            )
+        );
+        assert_eq!(
+            greeter_background(Path::new(DAY)),
+            (
+                PathBuf::from("/usr/share/backgrounds/isotope/isotope-desktop-day-blur.png"),
+                false
+            )
+        );
+    }
+
+    #[test]
+    fn another_picture_is_itself_with_a_scrim() {
+        assert_eq!(
+            greeter_background(Path::new("/home/x/pic.jpg")),
+            (PathBuf::from("/home/x/pic.jpg"), true)
+        );
+    }
+
+    #[test]
+    fn the_link_target_cosmic_bg_records_counts_as_the_wallpaper() {
+        // cosmic-bg canonicalizes its source: the state names the release
+        // picture the stable link points at.
+        let target = "/usr/share/backgrounds/isotope/isotope-1-hydrogen-day-3840x2160.png";
+        let resolve = |p: &Path| {
+            Some(if p == Path::new(DAY) {
+                PathBuf::from(target)
+            } else {
+                p.to_path_buf()
+            })
+        };
+        assert_eq!(
+            greeter_background_with(Path::new(target), resolve),
+            (
+                PathBuf::from("/usr/share/backgrounds/isotope/isotope-desktop-day-blur.png"),
+                false
+            )
+        );
+        // Another picture in the same directory is not one of the two.
+        let other = "/usr/share/backgrounds/isotope/isotope-tiles-night-3840x2160.png";
+        assert_eq!(
+            greeter_background_with(Path::new(other), resolve),
+            (PathBuf::from(other), true)
+        );
+    }
+
+    #[test]
+    fn an_unresolvable_path_is_not_a_match() {
+        assert_eq!(
+            greeter_background_with(Path::new("/gone.png"), |_| None),
+            (PathBuf::from("/gone.png"), true)
+        );
+    }
+}
