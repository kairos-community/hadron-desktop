+    /// Isotope: the picture for an output the user has no wallpaper for (a
+    /// user who has never logged in has no cosmic-bg state) and for every
+    /// output before a user is chosen: the system default wallpaper
+    /// (src/greeter/background.rs), soft, for the theme's mode. The built-in
+    /// picture stays, under the scrim, when there is none or it cannot be read.
+    fn load_fallback_background(&mut self, is_dark: bool) {
+        if self.fallback_is_dark == Some(is_dark) {
+            return;
+        }
+        self.fallback_is_dark = Some(is_dark);
+        let config = std::fs::read_to_string(background::SYSTEM_BACKGROUND_CONFIG)
+            .inspect_err(|err| {
+                tracing::warn!(
+                    "failed to read {}: {}",
+                    background::SYSTEM_BACKGROUND_CONFIG,
+                    err
+                )
+            })
+            .ok();
+        let Some((shown, scrim)) = background::fallback_background(config.as_deref(), is_dark)
+        else {
+            return;
+        };
+        // The sharp picture, under the scrim, when the soft copy is missing.
+        let source = background::config_source(config.as_deref().unwrap_or_default())
+            .and_then(|p| background::default_wallpaper(Some(&p), is_dark));
+        let loaded = std::fs::read(&shown)
+            .map(|bytes| (bytes, scrim))
+            .or_else(|err| {
+                tracing::warn!("failed to read {:?}: {}", shown, err);
+                match source {
+                    Some(source) if source != shown => std::fs::read(&source).map(|b| (b, true)),
+                    _ => Err(err),
+                }
+            });
+        match loaded {
+            Ok((bytes, scrim)) => {
+                self.common.fallback_background = widget::image::Handle::from_bytes(bytes);
+                self.common.fallback_scrim = scrim;
+            }
+            Err(err) => tracing::warn!("no fallback background: {}", err),
+        }
+    }
